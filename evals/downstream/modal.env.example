# The launch environment of the five evaluation packages (evals/downstream/README.md, "Launcher environment"). Copy it,
# fill in your own Modal workspace's names, and source it before a launch:
#
#     cp evals/downstream/modal.env.example evals/downstream/modal.env    # then edit
#     set -a; source evals/downstream/modal.env; set +a
#     modal run evals/downstream/modal_workspace_understanding.py::run_all --run-id <run-id>
#
# Every value below is the launchers' own default; an unset variable takes it. Each launcher copies the
# variables it reads into its containers.

MODAL_PROFILE=<your-modal-profile>
# EVAL_APP=maemm-<package-name-with-dashes>   # the Modal app, per launcher

# The secrets. The HF secret carries HF_TOKEN (the three activation evals), the Anthropic secret
# ANTHROPIC_API_KEY (the `sonnet` judge, the default of the workspace and coherence evals, and the BiPO
# `describe` stage), the OpenRouter secret OPENROUTER_API_KEY (the `sol` judge, the default of the steering
# evals). A launcher always mounts its default profile's secret and the other only when it is named here, so
# naming both lets every package run under either profile.
EVAL_HF_SECRET=maemm-hf
EVAL_ANTHROPIC_SECRET=maemm-anthropic
EVAL_OPENROUTER_SECRET=maemm-openrouter

# The three activation evals: the volume their run directories live on, the HF cache on it, and the root
# their run directories go under, as <root>/<package>/<run-id>; EVAL_OUTPUT_DIR_<PACKAGE> overrides the
# root for one package.
EVAL_VOLUME=maemm-data
EVAL_HF_HOME=/data/hf_cache
EVAL_OUTPUT_DIR=/data
# EVAL_OUTPUT_DIR_WORKSPACE_UNDERSTANDING=/data/workspace_understanding
# EVAL_OUTPUT_DIR_WORKSPACE_MODULATION=/data/workspace_modulation
# EVAL_OUTPUT_DIR_ROLLOUT_COHERENCE=/data/rollout_coherence

# The two steering evals keep their run directories on the controller (--output-dir, evals/downstream/out/) and their
# model snapshots on a cache volume of their own.
EVAL_MODEL_CACHE_VOLUME=maemm-eval-model-cache
EVAL_MODEL_CACHE_DIR=/cache/models

# GPUs. The defaults are B200:1 for the activation evals and H200 (B200 for two-model stages) for the
# steering evals; set these to override every launcher at once.
# EVAL_GPU=B200:1
# EVAL_GPU_BOTH_MODELS=B200:1
# EVAL_GPU_TRAINING=B200          # BiPO vector training (steering_vector_inversion_bipo)
# EVAL_GPU_WORKERS=8              # GPU containers a launcher holds at once
# EVAL_GPU_COST_PER_HOUR=6.2496   # the $/h rate of the activation evals' GPU cost estimate (B200 list rate)

# How the corpus-search forward and workspace_understanding's NLA generation are split into containers.
# EVAL_RETRIEVAL_SHARDS=8         # workspace_understanding's default; rollout_coherence's is 4
# EVAL_NLA_SHARDS=2

# The model pins (evals/downstream/common/pins.py holds the defaults; an unset or empty variable keeps them), e.g. to
# read a mirror of a checkpoint.
# EVAL_BASE_REPO=            EVAL_BASE_REVISION=
# EVAL_INVERTER_REPO=        EVAL_INVERTER_REVISION=
# EVAL_NLA_REPO=             EVAL_NLA_REVISION=
# EVAL_LENS_REPO=            EVAL_LENS_REVISION=
