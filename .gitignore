# python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# data / weights / artifacts (never commit — big + often private)
data/
checkpoints/
ckpts/
*.pt
*.f32
*.f16
*.npy
*.npz
*.safetensors
*.parquet

# Reader outputs: `precompute/common.out_dir` defaults here, BESIDE paper-evals/ and never
# inside it -- Modal mounts paper-evals/ into every image build and a write under it kills any
# launch racing the hash. $MAEMM_OUT moves it; the mirror (a pure volume cache) goes to
# $XDG_CACHE_HOME instead, outside the repo entirely.
_out/

# logs / runs
wandb/
logs/
*.log
nohup.out

# secrets — NEVER commit
.env
*.key
*token*
*_secret*
.modal.toml
modal.toml
# box-side run_*.sh launchers often carry hardcoded keys — keep them out
run_*.sh
eval/out/
!eval/common/assets/mu.f32

# backdoors/data/ holds small committed JSON products. The repo-wide `data/` rule above would
# swallow them -- they would need `git add -f` and would then never appear in `git status`, so
# anything readout/specs.py writes there would be silently invisible. Un-exclude it.
!backdoors/data/
!backdoors/data/*.json
backdoors/out/
